# Local default: SQLite file next to prisma/schema.prisma (created by npm run setup).
# Vercel preview: leave this unset and connect Prisma Postgres (sets DATABASE_URL for you).
DATABASE_URL="file:./dev.db"

# Signs guest/login cookies. Any random string is fine for a play-money demo.
AUTH_SECRET="dev-skill-match-secret-change-me"
