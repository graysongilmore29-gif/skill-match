{
  "name": "skill-match",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "node scripts/prisma-run.mjs build && next build",
    "start": "next start --port 3000",
    "lint": "eslint",
    "test": "tsx --test src/lib/match-rules.test.ts",
    "db:generate": "node scripts/prisma-run.mjs generate",
    "db:push": "node scripts/prisma-run.mjs push",
    "db:seed": "node scripts/prisma-run.mjs seed",
    "db:setup": "node scripts/prisma-run.mjs setup",
    "setup": "node scripts/ensure-env.mjs && npm run db:setup",
    "preview:deploy": "node scripts/preview-deploy.mjs",
    "e2e:api": "node scripts/e2e-api.mjs",
    "postinstall": "node scripts/prisma-run.mjs generate"
  },
  "engines": {
    "node": ">=22"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "16.3.5",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
